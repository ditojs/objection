{
  "name": "objection",
  "version": "3.5.0",
  "description": "An SQL-friendly ORM for Node.js",
  "type": "module",
  "main": "lib/objection.js",
  "exports": {
    ".": {
      "types": "./typings/objection/index.d.ts",
      "default": "./lib/objection.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "scripts": {
    "test": "npm run eslint && vitest run && npm run test:typings",
    "test:fast": "vitest run --bail 1",
    "test:watch": "vitest",
    "test:typings": "tsc && prettier --check \"typings/**/*.ts\" \"tests/ts/**/*.ts\"",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "build:parsers": "npx --yes peggy@5.1.0 --format es -o lib/queryBuilder/parsers/jsonFieldExpressionParser.js lib/queryBuilder/parsers/jsonFieldExpressionParser.pegjs && npx --yes peggy@5.1.0 --format es -o lib/queryBuilder/parsers/relationExpressionParser.js lib/queryBuilder/parsers/relationExpressionParser.pegjs && prettier --write \"lib/queryBuilder/parsers/*Parser.js\"",
    "prettier": "prettier --write \"{examples,lib,tests,testUtils,typings,doc}/**/*.{js,ts}\"",
    "eslint": "eslint --format codeframe \"examples/**/*.js\" \"lib/**/*.js\" \"tests/**/*.js\" \"testUtils/**/*.js\" \"*.js\"",
    "docs:dev": "vitepress dev doc",
    "docs:build": "vitepress build doc",
    "docs:preview": "vitepress preview doc"
  },
  "publishConfig": {
    "tag": "latest"
  },
  "author": {
    "name": "Sami Koskimäki",
    "email": "sami@jakso.me",
    "url": "https://github.com/koskimas"
  },
  "contributors": [
    "Sami Koskimäki <sami@jakso.me> (https://github.com/koskimas)",
    "Mikael Lepistö <mikael.lepisto@vincit.com> (https://github.com/elhigu)",
    "Matthew McEachen <matthew-objection@photostructure.com> (https://github.com/mceachen)",
    "Jürg Lehni <juerg@scratchdisk.com> (https://github.com/lehni)",
    "Igor Savin <kibertoad@gmail.com> (https://github.com/kibertoad)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditojs/objection.git"
  },
  "bugs": {
    "url": "https://github.com/ditojs/objection/issues"
  },
  "homepage": "https://ditojs.github.io/objection/",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "keywords": [
    "orm",
    "knex",
    "sql",
    "query",
    "query builder",
    "postgresql",
    "mysql",
    "sqlite3"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "lib/*",
    "typings/*"
  ],
  "types": "./typings/objection/index.d.ts",
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "peerDependencies": {
    "knex": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "eslint": "^8.54.0",
    "eslint-formatter-codeframe": "^7.32.1",
    "eslint-plugin-prettier": "^5.3.1",
    "knex": "^3.3.0",
    "mysql": "^2.18.1",
    "pg": "^8.15.6",
    "prettier": "3.9.9",
    "sqlite3": "^6.0.1",
    "typescript": "^7.0.0",
    "vitepress": "1.6.4",
    "vitest": "^4.1.11"
  }
}
