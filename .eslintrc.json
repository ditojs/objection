{
  "root": true,
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": [
    "prettier"
  ],
  "rules": {
    "prettier/prettier": "error",
    "no-undef": "error"
  },
  "env": {
    "es6": true,
    "node": true,
    "mocha": true
  },
  "overrides": [
    {
      "files": ["tests/unit/relations/files/*.js"],
      "parserOptions": {
        "sourceType": "script"
      }
    }
  ]
}
